# Runtime settings. Keep the real values in an untracked .env on the VPS.
# For local Next.js use .env.local (tracking is restricted to the live domain).
GOATCOUNTER_SITE=
GOATCOUNTER_API_KEY=
# Actual first tracking day, YYYY-MM-DD in UTC. Do not backdate it.
GOATCOUNTER_START_DATE=
# Enable only after the provider settings and privacy disclosure are checked.
WEBSITE_ANALYTICS_ENABLED=false
